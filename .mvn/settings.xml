<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <profiles>
    <profile>
      <id>nms-core-ext</id>
      <pluginRepositories>
        <pluginRepository>
          <id>nms-core-ext</id>
          <url>https://codeberg.org/api/packages/colbster937/maven/</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <servers>
    <server>
      <id>github</id>
      <username>${env.GITHUB_ACTOR}</username>
      <password>${env.GITHUB_TOKEN}</password>
      <repositoryOrigins>
        <repositoryOrigin>https://maven.pkg.github.com</repositoryOrigin>
      </repositoryOrigins>
    </server>

    <server>
      <id>codeberg</id>
      <username>${env.CODEBERG_USERNAME}</username>
      <password>${env.CODEBERG_PASSWORD}</password>
      <repositoryOrigins>
        <repositoryOrigin>https://codeberg.org</repositoryOrigin>
      </repositoryOrigins>
    </server>
  </servers>

  <activeProfiles>
    <activeProfile>nms-core-ext</activeProfile>
  </activeProfiles>
</settings>
